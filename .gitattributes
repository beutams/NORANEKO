* text=auto

# Unity text serialization
*.asset text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.unity text eol=lf

# Images and textures
*.png filter=lfs diff=lfs merge=lfs -text
